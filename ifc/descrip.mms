! DESCRIP.MMS for [.IFC]
!
! Every target whose name differs from its source has an explicit action.
! VSI MMS only applies its built-in rules when the target and source share
! the same file name, so without these it stops with %MMS-F-GWKNOACTS.
! The explicit actions work unchanged with MMK.
!
! IFC$MESSAGE and IFC$MESSAGE_INDENT come from a BLISS module by default.
! On x86-64, or anywhere without a BLISS compiler, an equivalent MACRO-32
! module is used instead.  To force it on other platforms:
!
!	$ MMS/MACRO=NOBLISS=1

PENVFLAGS   = /NOOBJECT/ENVIRONMENT=$(MMS$TARGET)/NOLIST

.IFDEF MMSX86_64
NOBLISS = 1
.ENDIF

.IFDEF NOBLISS
RTL_HELPER = OBJ$:IFC$RTL_MACRO.OBJ
.ELSE
RTL_HELPER = OBJ$:IFC$RTL_BLISS.OBJ
.ENDIF

.IFDEF MMSALPHA
.FIRST :
	@ IF (F$SEARCH("DISK$COMMON:[KEDNOS_AXP_TOOLS.PASCAL060]KEDNOS_PASCAL.COM") .NES. "") THEN -
	    @DISK$COMMON:[KEDNOS_AXP_TOOLS.PASCAL060]KEDNOS_PASCAL
.ENDIF

ALL : ENV_FILES IFC_RTL EXE$:IFC.EXE
	@ CONTINUE

ENV_FILES : LIB$:IFC$MSG_DEF.PEN LIB$:IFC$LEX_DEF.PEN -
            LIB$:IFC$ROOM_DEF.PEN LIB$:IFC$MESSAGE_DEF.PEN -
            LIB$:IFC$OBJECT_DEF.PEN
	@ CONTINUE

IFC_RTL : LIB$:IFC$RTL_DEF.PEN LIB$:IFC$RTL.OLB
	@ CONTINUE

EXE$:IFC.EXE : OBJ$:IFC.OBJ OBJ$:IFC$MSG.OBJ OBJ$:IFC$CLD.OBJ -
               OBJ$:IFC$LEX.OBJ OBJ$:IFC$MESSAGE.OBJ OBJ$:IFC$ROOM.OBJ -
               OBJ$:IFC$OBJECT.OBJ
	LINK/EXECUTABLE=$(MMS$TARGET) $(MMS$SOURCE_LIST)

LIB$:IFC$RTL.OLB : OBJ$:IFC$RTL_SCREEN.OBJ OBJ$:IFC$RTL_PASCAL.OBJ -
                   $(RTL_HELPER) OBJ$:IFC$MSG.OBJ
	IF F$SEARCH("$(MMS$TARGET)") .EQS. "" THEN LIBRARY/CREATE/OBJECT $(MMS$TARGET)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(MMS$SOURCE_LIST)

! ---- Object files ----

OBJ$:IFC$RTL_MACRO.OBJ : IFCRTL_MACRO.MAR
	$(MACRO)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$RTL_BLISS.OBJ : IFCRTL_BLISS.BLI
	BLISS/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$RTL_PASCAL.OBJ : IFCRTL_PASCAL.PAS LIB$:IFC$MSG_DEF.PEN LIB$:IFC$RTL_DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$RTL_SCREEN.OBJ : IFCRTL_SCREEN.PAS LIB$:IFC$RTL_DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)

OBJ$:IFC.OBJ : IFC.PAS LIB$:IFC$MSG_DEF.PEN LIB$:IFC$MESSAGE_DEF.PEN -
               LIB$:IFC$ROOM_DEF.PEN LIB$:IFC$OBJECT_DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$LEX.OBJ : IFCLEX.PAS LIB$:IFC$DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$MESSAGE.OBJ : IFCMESSAGE.PAS LIB$:IFC$LEX_DEF.PEN LIB$:IFC$DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$ROOM.OBJ : IFCROOM.PAS LIB$:IFC$LEX_DEF.PEN LIB$:IFC$DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$OBJECT.OBJ : IFCOBJECT.PAS LIB$:IFC$LEX_DEF.PEN LIB$:IFC$DEF.PEN
	$(PASCAL)/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$CLD.OBJ : IFCCLD.CLD
	SET COMMAND/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)
OBJ$:IFC$MSG.OBJ : IFCMSG.MSG
	MESSAGE/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)

! ---- Pascal environment files ----

LIB$:IFC$MSG_DEF.PEN : IFCMSG_DEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$LEX_DEF.PEN : IFCLEX_DEF.PAS LIB$:IFC$DEF.PEN
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$MESSAGE_DEF.PEN : IFCMESSAGE_DEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$ROOM_DEF.PEN : IFCROOM_DEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$OBJECT_DEF.PEN : IFCOBJECT_DEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$RTL_DEF.PEN : IFCRTL_DEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)
LIB$:IFC$DEF.PEN : IFCDEF.PAS
	$(PASCAL)$(PENVFLAGS) $(MMS$SOURCE)

CLEAN :
	@ CONTINUE

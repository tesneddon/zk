$ set noon
$ if (p1 .eqs. "") then p1 = "ZKUAF.DAT"
$ if (f$search(p1) .nes. "")
$ then
$   say "%E, ''p1' already exists, not creating"
$   exitt 1
$ endif
$ create/fdl=sys$input 'p1'
$ deck
TITLE	"ZK UAF"

IDENT	" 2-JUL-2013 19:24:08  OpenVMS FDL Editor"

SYSTEM
	SOURCE			"OpenVMS"

FILE
	NAME			"ZKUAF.DAT"
	ORGANIZATION		indexed

RECORD
	CARRIAGE_CONTROL	none
	FORMAT			fixed
	SIZE			512

AREA 0
	ALLOCATION		33
	BEST_TRY_CONTIGUOUS	yes
	BUCKET_SIZE		10
	EXTENSION		30

AREA 1
	ALLOCATION		30
	BEST_TRY_CONTIGUOUS	yes
	BUCKET_SIZE		10
	EXTENSION		30

AREA 2
	ALLOCATION		60
	BEST_TRY_CONTIGUOUS	yes
	BUCKET_SIZE		10
	EXTENSION		60

KEY 0
	CHANGES			no
	DATA_AREA		0
	DATA_FILL		100
	DATA_KEY_COMPRESSION	no
	DATA_RECORD_COMPRESSION	no
	DUPLICATES		no
	INDEX_AREA		1
	INDEX_COMPRESSION	no
	INDEX_FILL		100
	LEVEL1_INDEX_AREA	1
	NAME			"Email address"
	PROLOG			0
	SEG0_LENGTH		100
	SEG0_POSITION		0
	TYPE			string

KEY 1
	CHANGES			no
	DATA_AREA		2
	DATA_FILL		100
	DATA_KEY_COMPRESSION	no
	DUPLICATES		no
	INDEX_AREA		2
	INDEX_COMPRESSION	no
	INDEX_FILL		100
	LEVEL1_INDEX_AREA	2
	NAME			"GUID"
	SEG0_LENGTH		36
	SEG0_POSITION		0
	TYPE			string
$ eod
$ exitt 1

!++
!   MODULE DESCRIPTION:
!
!       The Halls of ZK OpenVMS build procedure
!
!   AUTHOR:         Tim E. Sneddon
!
!   CREATION DATE:  19-NOV-2026
!
!   MODIFICATION HISTORY:
!
!       19-NOV-2026 V2.0    Sneddon   One description file for ENV, IFC and
!                                     ZK, in the style of ETM.  Builds with
!                                     MMK and MMS.
!--

.IF .NOT AT
AT = @
.ENDIF
FACILITY = ZK
ECHO = WRITE SYS$OUTPUT
BACKUP = BACKUP/INTERCHANGE/BLOCK_SIZE=8192
IFC = MCR EXE$:IFC

! Every action names its source and target, so neither MMK nor MMS has to
! match a source to its target by name: the object for SRC$:ZKMAIN.PAS is
! OBJ$:ZKMAIN.OBJ, but the environment file for SRC$:ZKDEF.PAS has to be
! LIB$:ZK$DEF.PEN, as the sources inherit it by that name.
.IFDEF DEBUG
PDEBUG = /DEBUG/NOOPTIMIZE/LIST=LIS$:
LDEBUG = /DEBUG
.ELSE
PDEBUG = /NOLIST
LDEBUG =
.ENDIF
.IFDEF VERSION
LTRACE = /NOTRACEBACK
.ELSE
LTRACE =
.ENDIF
PFLAGS = /OBJECT=$(MMS$TARGET)$(PDEBUG)
PENV = $(PASCAL)/NOOBJECT/NOLIST/ENVIRONMENT=$(MMS$TARGET) $(MMS$SOURCE)
MFLAGS = /OBJECT=$(MMS$TARGET)/NOLIST
BFLAGS = /OBJECT=$(MMS$TARGET)/NOLIST
LINKFLAGS = $(LTRACE)$(LDEBUG)

.SUFFIXES :
.SUFFIXES : .EXE .OLB .OBJ .PEN .PAS .MAR .BLI .MSG .CLD

.PAS.OBJ :
    @ $(ECHO) "  pascal      $(MMS$TARGET)"
    $(AT) $(PASCAL)$(PFLAGS) $(MMS$SOURCE)

.MAR.OBJ :
    @ $(ECHO) "  macro       $(MMS$TARGET)"
    $(AT) $(MACRO)$(MFLAGS) $(MMS$SOURCE)

.BLI.OBJ :
    @ $(ECHO) "  bliss       $(MMS$TARGET)"
    $(AT) $(BLISS)$(BFLAGS) $(MMS$SOURCE)

.MSG.OBJ :
    @ $(ECHO) "  message     $(MMS$TARGET)"
    $(AT) MESSAGE/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)

.CLD.OBJ :
    @ $(ECHO) "  cld         $(MMS$TARGET)"
    $(AT) SET COMMAND/OBJECT=$(MMS$TARGET) $(MMS$SOURCE)

.OBJ.OLB :
    @ $(ECHO) "  libr        $(MMS$TARGET)"
    $(AT) IF F$SEARCH("$(MMS$TARGET)") .EQS. "" THEN $(LIBR)/CREATE $(MMS$TARGET)
    $(AT) $(LIBR)/REPLACE $(MMS$TARGET) $(MMS$SOURCE)

.FIRST :
    @ $(ECHO) ""
    @ $(ECHO) "  The Halls of ZK"
    @ $(ECHO) ""
    @ $(ECHO) " DATE:   ''F$TIME()'"
    @ $(ECHO) " USER:   ''F$GETSYI("NODENAME")'::''F$EDIT(F$GETJPI(0,"USERNAME"),"COLLAPSE,UPCASE")'"
.IFDEF DEBUG
    @ $(ECHO) " DEBUG:  ON"
.ELSE
    @ $(ECHO) " DEBUG:  OFF"
.ENDIF
.IFDEF VERSION
    @ $(ECHO) " VERSION: $(VERSION)"
.ELSE
    @ $(ECHO) " VERSION: X0.0"
.ENDIF
    @ $(ECHO) " ENVIRONMENT:"
    $(AT) TOP = F$ENVIRONMENT("DEFAULT")
    $(AT) TOP = F$PARSE(TOP,,,"DEVICE","NO_CONCEAL")+F$PARSE(TOP,,,"DIRECTORY","NO_CONCEAL")-"]["-"]"-".000000"+".]"
    $(AT) DEFINE/JOB/NOLOG/TRANSLATION=CONCEALED TOP$ 'TOP'
    $(AT) DEFINE/JOB/NOLOG EXE$ TOP$:[$(MMSARCH_NAME)_EXE]
    $(AT) IF F$PARSE("EXE$:A.A") .EQS. "" THEN CREATE/DIRECTORY EXE$:
    $(AT) DEFINE/JOB/NOLOG LIB$ TOP$:[$(MMSARCH_NAME)_LIB]
    $(AT) IF F$PARSE("LIB$:A.A") .EQS. "" THEN CREATE/DIRECTORY LIB$:
    $(AT) DEFINE/JOB/NOLOG LIS$ TOP$:[$(MMSARCH_NAME)_LIS]
    $(AT) IF F$PARSE("LIS$:A.A") .EQS. "" THEN CREATE/DIRECTORY LIS$:
    $(AT) DEFINE/JOB/NOLOG OBJ$ TOP$:[$(MMSARCH_NAME)_OBJ]
    $(AT) IF F$PARSE("OBJ$:A.A") .EQS. "" THEN CREATE/DIRECTORY OBJ$:
    $(AT) DEFINE/JOB/NOLOG SRC$ TOP$:[ENV],TOP$:[IFC],TOP$:[ZK]
    $(AT) DEFINE/JOB/NOLOG IFC$LIBRARY LIB$
    $(AT) PIPE SHOW LOGICAL %%%$,IFC$LIBRARY/TABLE=LNM$JOB | SEARCH SYS$PIPE =
    $(AT) ! ======================================

! Environments.  Each names its file and every environment it inherits,
! so a source lists only what it inherits itself.
TYPEDEF_PEN = LIB$:TYPEDEF.PEN
CLIDEF_PEN = LIB$:CLIDEF.PEN $(TYPEDEF_PEN)
DSCDEF_PEN = LIB$:DSCDEF.PEN $(TYPEDEF_PEN)
EVENTDEF_PEN = LIB$:EVENTDEF.PEN $(TYPEDEF_PEN)
LOCKDEF_PEN = LIB$:LOCKDEF.PEN $(TYPEDEF_PEN)
QIODEF_PEN = LIB$:QIODEF.PEN $(TYPEDEF_PEN)
RTLDEF_PEN = LIB$:RTLDEF.PEN $(TYPEDEF_PEN)
SECDEF_PEN = LIB$:SECDEF.PEN $(TYPEDEF_PEN)
SHRDEF_PEN = LIB$:SHRDEF.PEN
SMGDEF_PEN = LIB$:SMGDEF.PEN $(TYPEDEF_PEN)
STSDEF_PEN = LIB$:STSDEF.PEN
SYSDEF_PEN = LIB$:SYSDEF.PEN $(TYPEDEF_PEN)

IFC_DEF_PEN = LIB$:IFC$DEF.PEN $(TYPEDEF_PEN)
IFC_LEX_DEF_PEN = LIB$:IFC$LEX_DEF.PEN $(IFC_DEF_PEN)
IFC_MESSAGE_DEF_PEN = LIB$:IFC$MESSAGE_DEF.PEN
IFC_MSG_DEF_PEN = LIB$:IFC$MSG_DEF.PEN
IFC_OBJECT_DEF_PEN = LIB$:IFC$OBJECT_DEF.PEN
IFC_ROOM_DEF_PEN = LIB$:IFC$ROOM_DEF.PEN
IFC_RTL_DEF_PEN = LIB$:IFC$RTL_DEF.PEN $(TYPEDEF_PEN)
IFC_RTL_PHONE_DEF_PEN = LIB$:IFC$RTL_PHONE_DEF.PEN $(TYPEDEF_PEN)

ZK_DEF_PEN = LIB$:ZK$DEF.PEN
ZK_DESC_PEN = LIB$:ZK$DESC.PEN
ZK_OBJ_PEN = LIB$:ZK$OBJ.PEN
ZK_ROOM_PEN = LIB$:ZK$ROOM.PEN
ZK_TEXT_PEN = LIB$:ZK$TEXT.PEN
ZK_CONTEXT_DEF_PEN = LIB$:ZK$CONTEXT_DEF.PEN $(TYPEDEF_PEN) $(ZK_OBJ_PEN) -
                     $(ZK_ROOM_PEN)
ZK_ACTION_DEF_PEN = LIB$:ZK$ACTION_DEF.PEN $(ZK_CONTEXT_DEF_PEN)
ZK_AST_DEF_PEN = LIB$:ZK$AST_DEF.PEN $(ZK_DEF_PEN) $(ZK_CONTEXT_DEF_PEN)
ZK_INIT_DEF_PEN = LIB$:ZK$INIT_DEF.PEN $(ZK_CONTEXT_DEF_PEN)
ZK_LEX_DEF_PEN = LIB$:ZK$LEX_DEF.PEN $(ZK_DEF_PEN)
ZK_OBJECT_DEF_PEN = LIB$:ZK$OBJECT_DEF.PEN $(ZK_CONTEXT_DEF_PEN)
ZK_PARSE_DEF_PEN = LIB$:ZK$PARSE_DEF.PEN $(ZK_DEF_PEN) $(ZK_CONTEXT_DEF_PEN)
ZK_PARSE_OBJ_DEF_PEN = LIB$:ZK$PARSE_OBJ_DEF.PEN $(ZK_DEF_PEN)
ZK_ROUTINES_DEF_PEN = LIB$:ZK$ROUTINES_DEF.PEN $(TYPEDEF_PEN) -
                      $(ZK_CONTEXT_DEF_PEN)
ZK_WIZARD_DEF_PEN = LIB$:ZK$WIZARD_DEF.PEN $(ZK_CONTEXT_DEF_PEN)

! Objects, as module=file, so that MMK and MMS can find each module in
! its library.  The library module is named by the source's MODULE or
! PROGRAM, not by its file.
IFC_OBJECTS = IFC=OBJ$:IFC.OBJ,IFC$LEX=OBJ$:IFCLEX.OBJ,-
              IFC$MESSAGE=OBJ$:IFCMESSAGE.OBJ,IFC$OBJECT=OBJ$:IFCOBJECT.OBJ,-
              IFC$ROOM=OBJ$:IFCROOM.OBJ,IFC$MSG=OBJ$:IFCMSG.OBJ,-
              IFC$COMMAND_TABLE=OBJ$:IFCCLD.OBJ
IFC_RTL_OBJECTS = IFC$RTL_SCREEN=OBJ$:IFCRTL_SCREEN.OBJ,-
                  IFC$RTL_PASCAL=OBJ$:IFCRTL_PASCAL.OBJ,-
                  IFC$RTL_BLISS=OBJ$:IFCRTL_BLISS.OBJ,-
                  IFC$MSG=OBJ$:IFCMSG.OBJ
IFC_RTL_PHONE_OBJECTS = IFC$RTL_PHONE=OBJ$:IFCRTL_PHONE.OBJ,-
                        IFC$RTL_PASCAL=OBJ$:IFCRTL_PASCAL.OBJ,-
                        IFC$RTL_BLISS=OBJ$:IFCRTL_BLISS.OBJ,-
                        IFC$MSG=OBJ$:IFCMSG.OBJ
ZK_OBJECTS = ZK$MAIN=OBJ$:ZKMAIN.OBJ,ZK$PHONE=OBJ$:ZKPHONE.OBJ,-
             ZK$ACTION=OBJ$:ZKACTION.OBJ,ZK$AST=OBJ$:ZKAST.OBJ,-
             ZK$INIT=OBJ$:ZKINIT.OBJ,ZK$LEX=OBJ$:ZKLEX.OBJ,-
             ZK$OBJECT=OBJ$:ZKOBJECT.OBJ,ZK$PARSE=OBJ$:ZKPARSE.OBJ,-
             ZK$PARSE_OBJECT=OBJ$:ZKPARSE_OBJ.OBJ,-
             ZK$ROUTINES=OBJ$:ZKROUTINES.OBJ,ZK$WIZARD=OBJ$:ZKWIZARD.OBJ

! The game's data, compiled by IFC.  Each module is named by its prefix.
ZK_DATA_OBJECTS = ZK$DESC_DATA=OBJ$:ZKDESC.OBJ,ZK$OBJ_DATA=OBJ$:ZKOBJ.OBJ,-
                  ZK$ROOM_DATA=OBJ$:ZKROOM.OBJ,ZK$TEXT_DATA=OBJ$:ZKTEXT.OBJ

! Libraries
IFC_OLB = LIB$:IFC.OLB
LIBIFC = $(IFC_OLB)($(IFC_OBJECTS))
IFC_RTL_OLB = LIB$:IFC$RTL.OLB
LIBIFC_RTL = $(IFC_RTL_OLB)($(IFC_RTL_OBJECTS))
IFC_RTL_PHONE_OLB = LIB$:IFC$RTL_PHONE.OLB
LIBIFC_RTL_PHONE = $(IFC_RTL_PHONE_OLB)($(IFC_RTL_PHONE_OBJECTS))
ZK_OLB = LIB$:ZK.OLB
LIBZK = $(ZK_OLB)($(ZK_OBJECTS),$(ZK_DATA_OBJECTS))

! Top level targets.  ALL comes first, as the default.  DEFINE runs only
! .FIRST, for the logicals: MMK looks for the sources in SRC$ before it
! runs .FIRST, so a new session needs MMK DEFINE first.
ALL : EXE$:IFC.EXE EXE$:ZK$MAIN.EXE EXE$:ZK$PHONE.EXE
    $(AT) !

DEFINE :
    $(AT) !

TOOLS : EXE$:IFC.EXE EXE$:ZK$LINK_TIME.EXE EXE$:MAKE_VERSION.EXE
    $(AT) !

CLEAN :
    $(AT) IF F$SEARCH("EXE$:*.*") .NES. "" THEN DELETE/NOLOG EXE$:*.*;*
    $(AT) IF F$SEARCH("LIB$:*.*") .NES. "" THEN DELETE/NOLOG LIB$:*.*;*
    $(AT) IF F$SEARCH("LIS$:*.*") .NES. "" THEN DELETE/NOLOG LIS$:*.*;*
    $(AT) IF F$SEARCH("OBJ$:*.*") .NES. "" THEN DELETE/NOLOG OBJ$:*.*;*

.IFDEF VERSION
KIT : VERSION ALL
    $(AT) DEFINE/JOB/NOLOG KIT$ TOP$:[KIT.'F$TRNLNM("$VMI$")']
    $(AT) CREATE/NOLOG/DIRECTORY KIT$:
    $(AT) $(BACKUP) TOP$:[KIT]KITINSTAL.COM,ZKCLD.CLD,ZKDCL_HELP.HLP -
        KIT$:'F$TRNLNM("$VMI$")'.A/SAVE_SET
    $(AT) $(BACKUP) TOP$:[VAX_EXE]ZK$MAIN.EXE KIT$:'F$TRNLNM("$VMI$")'.B/SAVE_SET
    $(AT) $(BACKUP) TOP$:[ALPHA_EXE]ZK$MAIN.EXE KIT$:'F$TRNLNM("$VMI$")'.C/SAVE_SET
    $(AT) $(BACKUP) TOP$:[IA64_EXE]ZK$MAIN.EXE KIT$:'F$TRNLNM("$VMI$")'.D/SAVE_SET
    $(AT) $(BACKUP) TOP$:[X86_64_EXE]ZK$MAIN.EXE KIT$:'F$TRNLNM("$VMI$")'.E/SAVE_SET

VERSION :
    $(AT) TYPE = F$EDIT(F$EXTRACT(0, 1, "$(VERSION)"), "UPCASE")
    $(AT) IF (F$TYPE(TYPE) .NES. "STRING") THEN TYPE = ""
    $(AT) ED = F$ELEMENT(1, "-", "$(VERSION)"-TYPE)
    $(AT) IF (ED .EQS. "-") THEN ED = ""
    $(AT) MAJ=F$ELEMENT(0, "-" , "$(VERSION)"-TYPE)
    $(AT) IF (MAJ .EQS. "") THEN MAJ="1"
    $(AT) MIN=F$ELEMENT(1, ".", MAJ)
    $(AT) IF (MIN .EQS. ".") THEN MIN = "0"
    $(AT) MAJ=F$ELEMENT(0, ".", MAJ)
    $(AT) IF (TYPE .EQS. "") THEN TYPE = "X"
    $(AT) VERSION = TYPE + MAJ + "." + MIN
    $(AT) IF (ED .NES. "") THEN VERSION = VERSION + "-" + ED
    $(AT) PCSI = TYPE + F$FAO("!2ZL", F$INT(MAJ)) + F$FAO("!2ZL", F$INT(MIN))
    $(AT) VMI = "$(FACILITY)" + F$FAO("!2ZL", F$INT(MAJ)) + F$FAO("!1ZL", F$INT(MIN))
    $(AT) IF (ED .NES. "") THEN PCSI = PCSI + "-" + ED
    $(AT) IF (TYPE .EQS. "E") THEN TYPE = "EARLY-ADOPTER"
    $(AT) IF (TYPE .EQS. "T") THEN TYPE = "FIELD-TEST"
    $(AT) IF (TYPE .EQS. "V") THEN TYPE = "RELEASE"
    $(AT) IF (TYPE .EQS. "X") THEN TYPE = "EXPERIMENTAL"
    $(AT) IF (F$LENGTH(TYPE) .LE. 1) THEN TYPE="OTHER"
    $(AT) DEFINE/JOB/NOLOG $PCSI$ "''PCSI'"
    $(AT) DEFINE/JOB/NOLOG $TYPE$ "''TYPE'"
    $(AT) DEFINE/JOB/NOLOG $VERS$ "''VERSION'"
    $(AT) DEFINE/JOB/NOLOG $VMI$  "''VMI'"
.ELSE
KIT :
    @ $(ECHO) "%W, VERSION macro not specified"
    @ $(ECHO) ""
    @ $(ECHO) "The KIT target must be called like so:"
    @ $(ECHO) ""
    @ $(ECHO) "    $$(MMS) KIT/MACRO=""VERSION=V1.1"""
    @ $(ECHO) ""
.ENDIF

! Executables.  Each ZK link first writes LIB$:ZKLINK_TIME.OPT and
! LIB$:ZKVERSION.OPT; the phone links after the game, with the same ones.
EXE$:IFC.EXE : $(LIBIFC)
    @ $(ECHO) "  link        $(MMS$TARGET)"
    $(AT) $(LINK)$(LINKFLAGS)/EXECUTABLE=$(MMS$TARGET) $(IFC_OLB)/INCLUDE=IFC,-
        $(IFC_OLB)/LIBRARY

EXE$:ZK$MAIN.EXE : $(LIBZK) $(LIBIFC_RTL) SRC$:ZKMAIN_LNK.OPT -
                   EXE$:ZK$LINK_TIME.EXE EXE$:MAKE_VERSION.EXE
    @ $(ECHO) "  version     LIB$:ZKLINK_TIME.OPT, LIB$:ZKVERSION.OPT"
    $(AT) RUN EXE$:ZK$LINK_TIME
.IFDEF VERSION
    $(AT) PIPE ( WRITE SYS$OUTPUT "LIB$:ZKVERSION.OPT" ; -
             WRITE SYS$OUTPUT "$(VERSION)" ) | RUN EXE$:MAKE_VERSION
.ELSE
    $(AT) PIPE ( WRITE SYS$OUTPUT "LIB$:ZKVERSION.OPT" ; -
             WRITE SYS$OUTPUT "X0.0" ) | RUN EXE$:MAKE_VERSION
.ENDIF
    @ $(ECHO) "  link        $(MMS$TARGET)"
    $(AT) $(LINK)$(LINKFLAGS)/EXECUTABLE=$(MMS$TARGET) SRC$:ZKMAIN_LNK/OPTIONS,-
        LIB$:ZKLINK_TIME/OPTIONS,LIB$:ZKVERSION/OPTIONS

EXE$:ZK$PHONE.EXE : EXE$:ZK$MAIN.EXE $(LIBZK) $(LIBIFC_RTL_PHONE) -
                    SRC$:ZKPHONE_LNK.OPT
    @ $(ECHO) "  link        $(MMS$TARGET)"
    $(AT) $(LINK)$(LINKFLAGS)/EXECUTABLE=$(MMS$TARGET) SRC$:ZKPHONE_LNK/OPTIONS,-
        LIB$:ZKLINK_TIME/OPTIONS,LIB$:ZKVERSION/OPTIONS

! Tools
EXE$:ZK$LINK_TIME.EXE : OBJ$:ZKLINK_TIME.OBJ
    @ $(ECHO) "  link        $(MMS$TARGET)"
    $(AT) $(LINK)/EXECUTABLE=$(MMS$TARGET) $(MMS$SOURCE)

EXE$:MAKE_VERSION.EXE : OBJ$:MAKE_VERSION.OBJ
    @ $(ECHO) "  link        $(MMS$TARGET)"
    $(AT) $(LINK)/EXECUTABLE=$(MMS$TARGET) $(MMS$SOURCE)

! Objects: IFC
OBJ$:IFC.OBJ : SRC$:IFC.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) $(SYSDEF_PEN) -
               $(CLIDEF_PEN) $(IFC_MSG_DEF_PEN) $(IFC_MESSAGE_DEF_PEN) -
               $(IFC_ROOM_DEF_PEN) $(IFC_OBJECT_DEF_PEN)
OBJ$:IFCCLD.OBJ : SRC$:IFCCLD.CLD
OBJ$:IFCLEX.OBJ : SRC$:IFCLEX.PAS $(RTLDEF_PEN) $(IFC_DEF_PEN)
OBJ$:IFCMESSAGE.OBJ : SRC$:IFCMESSAGE.PAS $(IFC_LEX_DEF_PEN) $(IFC_DEF_PEN)
OBJ$:IFCMSG.OBJ : SRC$:IFCMSG.MSG
OBJ$:IFCOBJECT.OBJ : SRC$:IFCOBJECT.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                     $(IFC_DEF_PEN) $(IFC_LEX_DEF_PEN)
OBJ$:IFCROOM.OBJ : SRC$:IFCROOM.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                   $(IFC_LEX_DEF_PEN) $(IFC_DEF_PEN)
OBJ$:IFCRTL_BLISS.OBJ : SRC$:IFCRTL_BLISS.BLI
OBJ$:IFCRTL_PASCAL.OBJ : SRC$:IFCRTL_PASCAL.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                         $(IFC_MSG_DEF_PEN)
OBJ$:IFCRTL_PHONE.OBJ : SRC$:IFCRTL_PHONE.PAS $(TYPEDEF_PEN) $(DSCDEF_PEN) -
                        $(RTLDEF_PEN) $(SYSDEF_PEN) $(QIODEF_PEN)
OBJ$:IFCRTL_SCREEN.OBJ : SRC$:IFCRTL_SCREEN.PAS $(TYPEDEF_PEN) $(DSCDEF_PEN) -
                         $(RTLDEF_PEN) $(SYSDEF_PEN) $(SMGDEF_PEN)

! Objects: ZK
OBJ$:ZKACTION.OBJ : SRC$:ZKACTION.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                    $(SYSDEF_PEN) $(ZK_CONTEXT_DEF_PEN) $(ZK_ROUTINES_DEF_PEN) -
                    $(ZK_OBJECT_DEF_PEN) $(ZK_ROOM_PEN) $(ZK_TEXT_PEN) -
                    $(ZK_OBJ_PEN) $(ZK_DESC_PEN) $(IFC_RTL_DEF_PEN)
OBJ$:ZKAST.OBJ : SRC$:ZKAST.PAS $(RTLDEF_PEN) $(ZK_CONTEXT_DEF_PEN) -
                 $(ZK_DEF_PEN) $(ZK_OBJ_PEN) $(ZK_TEXT_PEN) -
                 $(ZK_ACTION_DEF_PEN) $(ZK_WIZARD_DEF_PEN) -
                 $(ZK_OBJECT_DEF_PEN) $(ZK_ROUTINES_DEF_PEN) -
                 $(ZK_INIT_DEF_PEN) $(IFC_RTL_DEF_PEN)
OBJ$:ZKINIT.OBJ : SRC$:ZKINIT.PAS $(TYPEDEF_PEN) $(SYSDEF_PEN) $(RTLDEF_PEN) -
                  $(ZK_CONTEXT_DEF_PEN) $(ZK_ROUTINES_DEF_PEN) -
                  $(ZK_ACTION_DEF_PEN) $(ZK_OBJ_PEN) $(ZK_ROOM_PEN) -
                  $(ZK_TEXT_PEN) $(IFC_RTL_DEF_PEN)
OBJ$:ZKLEX.OBJ : SRC$:ZKLEX.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) $(DSCDEF_PEN) -
                 $(IFC_RTL_DEF_PEN) $(ZK_DEF_PEN)
OBJ$:ZKMAIN.OBJ : SRC$:ZKMAIN.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) $(SMGDEF_PEN) -
                  $(SYSDEF_PEN) $(ZK_DEF_PEN) $(ZK_CONTEXT_DEF_PEN) -
                  $(ZK_PARSE_DEF_PEN) $(ZK_LEX_DEF_PEN) $(ZK_AST_DEF_PEN) -
                  $(ZK_TEXT_PEN) $(ZK_ACTION_DEF_PEN) $(ZK_INIT_DEF_PEN) -
                  $(IFC_RTL_DEF_PEN)
OBJ$:ZKOBJECT.OBJ : SRC$:ZKOBJECT.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                    $(SYSDEF_PEN) $(ZK_ROUTINES_DEF_PEN) $(ZK_ACTION_DEF_PEN) -
                    $(ZK_CONTEXT_DEF_PEN) $(ZK_ROOM_PEN) $(ZK_TEXT_PEN) -
                    $(ZK_OBJ_PEN) $(IFC_RTL_DEF_PEN)
OBJ$:ZKPARSE.OBJ : SRC$:ZKPARSE.PAS $(RTLDEF_PEN) $(ZK_DEF_PEN) -
                   $(ZK_CONTEXT_DEF_PEN) $(ZK_LEX_DEF_PEN) -
                   $(ZK_PARSE_OBJ_DEF_PEN)
OBJ$:ZKPARSE_OBJ.OBJ : SRC$:ZKPARSE_OBJ.PAS $(TYPEDEF_PEN) $(ZK_DEF_PEN) -
                       $(ZK_LEX_DEF_PEN) $(ZK_TEXT_PEN) $(ZK_OBJ_PEN) -
                       $(IFC_RTL_DEF_PEN)
OBJ$:ZKPHONE.OBJ : SRC$:ZKPHONE.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                   $(SYSDEF_PEN) $(ZK_DEF_PEN) $(ZK_CONTEXT_DEF_PEN) -
                   $(ZK_ROOM_PEN) $(ZK_OBJ_PEN) $(ZK_ROUTINES_DEF_PEN) -
                   $(ZK_PARSE_DEF_PEN) $(ZK_LEX_DEF_PEN) $(ZK_AST_DEF_PEN) -
                   $(ZK_TEXT_PEN) $(ZK_ACTION_DEF_PEN) $(ZK_INIT_DEF_PEN) -
                   $(IFC_RTL_DEF_PEN) $(IFC_RTL_PHONE_DEF_PEN)
OBJ$:ZKROUTINES.OBJ : SRC$:ZKROUTINES.PAS $(TYPEDEF_PEN) $(RTLDEF_PEN) -
                      $(ZK_CONTEXT_DEF_PEN) $(ZK_TEXT_PEN) $(ZK_OBJ_PEN) -
                      $(ZK_ROOM_PEN) $(IFC_RTL_DEF_PEN)
OBJ$:ZKWIZARD.OBJ : SRC$:ZKWIZARD.PAS $(TYPEDEF_PEN) $(ZK_CONTEXT_DEF_PEN) -
                    $(ZK_ROOM_PEN) $(ZK_TEXT_PEN) $(ZK_OBJ_PEN) -
                    $(ZK_ACTION_DEF_PEN) $(ZK_ROUTINES_DEF_PEN) -
                    $(IFC_RTL_DEF_PEN)
OBJ$:ZKLINK_TIME.OBJ : SRC$:ZKLINK_TIME.PAS $(TYPEDEF_PEN)
OBJ$:MAKE_VERSION.OBJ : SRC$:MAKE_VERSION.PAS

! Objects: the game's data
OBJ$:ZKDESC.OBJ : LIB$:ZKDESC.MAR
OBJ$:ZKOBJ.OBJ : LIB$:ZKOBJ.MAR
OBJ$:ZKROOM.OBJ : LIB$:ZKROOM.MAR
OBJ$:ZKTEXT.OBJ : LIB$:ZKTEXT.MAR

! Sources written by IFC: the MACRO for the data, and the Pascal
! definitions for the environment that describes it.
LIB$:ZKDESC.MAR : SRC$:ZKDESC.MESSAGE EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE MESSAGES $(MMS$SOURCE)/MACRO=$(MMS$TARGET)/DEFINITIONS=NLA0:
LIB$:ZKTEXT.MAR : SRC$:ZKTEXT.MESSAGE EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE MESSAGES $(MMS$SOURCE)/MACRO=$(MMS$TARGET)/DEFINITIONS=NLA0:
LIB$:ZKOBJ.MAR : SRC$:ZKOBJ.OBJECT EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE OBJECTS $(MMS$SOURCE)/MACRO=$(MMS$TARGET)/DEFINITIONS=NLA0:
LIB$:ZKROOM.MAR : SRC$:ZKROOM.ROOM EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE ROOMS $(MMS$SOURCE)/MACRO=$(MMS$TARGET)/DEFINITIONS=NLA0:

LIB$:ZK$DESC.PAS : SRC$:ZKDESC.MESSAGE EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE MESSAGES $(MMS$SOURCE)/MACRO=NLA0:/DEFINITIONS=$(MMS$TARGET)
LIB$:ZK$TEXT.PAS : SRC$:ZKTEXT.MESSAGE EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE MESSAGES $(MMS$SOURCE)/MACRO=NLA0:/DEFINITIONS=$(MMS$TARGET)
LIB$:ZK$OBJ.PAS : SRC$:ZKOBJ.OBJECT EXE$:IFC.EXE
    @ $(ECHO) "  ifc         $(MMS$TARGET)"
    $(AT) $(IFC) COMPILE OBJECTS $(MMS$SOURCE)/MACRO=NLA0:/DEFINITIONS=$(MMS$TARGET)
LIB$:ZK$ROOM.PAS : SRC$:ZKROOM.ROOM EXE$:IFC.EXE
